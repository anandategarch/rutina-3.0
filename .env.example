# Rutina 3.0 — contoh environment. Salin menjadi .env dan sesuaikan.
#
# ============================================================
# OPSI 1 — TURSO (disarankan untuk produksi / deploy Vercel)
# ============================================================
# Jika TURSO_DATABASE_URL terpasang, aplikasi OTOMATIS memakai Turso
# (lihat src/lib/db.ts). Set kedua variabel ini di .env lokal maupun di
# Environment Variables Vercel:
#
# TURSO_DATABASE_URL="libsql://nama-db-username.turso.io"
# TURSO_AUTH_TOKEN="eyJ..."    # buat via: turso db tokens create nama-db
#
# Sinkronkan schema Prisma ke Turso sekali di awal (atau setelah ubah schema):
#   bun scripts/turso-sync.ts
#
# Isi data sampling (idempoten, hanya mengisi tabel kosong):
#   bun scripts/seed.ts
#
# ============================================================
# OPSI 2 — SQLITE LOKAL (development offline)
# ============================================================
# Dipakai hanya jika TURSO_DATABASE_URL TIDAK terpasang.
#
# PENTING: Prisma (CLI maupun client) me-resolve path RELATIF terhadap lokasi
# prisma/schema.prisma, BUKAN terhadap root project. Jadi `file:./db/custom.db`
# akan mengarah ke prisma/db/custom.db — bukan db/custom.db di root.
#
# Opsi A (disarankan): path absolut menuju folder db/ di root project.
DATABASE_URL="file:/ABSOLUTE/PATH/TO/rutina/db/custom.db"
#
# Opsi B: path relatif dari folder prisma/ ke folder db/ di root.
# DATABASE_URL="file:../db/custom.db"
