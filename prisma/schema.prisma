generator client {
  provider = "prisma-client-js"
  // Catatan: driver adapters sudah GA sejak Prisma 6 — flag preview
  // "driverAdapters" tidak lagi diperlukan. Adapter libSQL (Turso) dipasang
  // di src/lib/db.ts via @prisma/adapter-libsql.
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ PROFILE ============

model Profile {
  id                 String   @id @default("main")
  name               String   @default("Sahabat Rutina")
  identityVoice      String   @default("Aku adalah orang yang konsisten, disiplin, dan tumbuh setiap hari.")
  dailyMissionTarget Int      @default(4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============ HABITS (The Garden) ============

model Habit {
  id           String     @id @default(cuid())
  name         String
  category     String     @default("health") // health | productivity | mind | finance | social | learning
  icon         String     @default("sprout") // lucide icon key
  color        String     @default("emerald") // token key: emerald|amber|teal|rose|orange|stone
  scheduleType String     @default("daily") // daily | custom
  daysOfWeek   String     @default("0,1,2,3,4,5,6") // csv, 0=Sun..6=Sat
  timeOfDay    String     @default("anytime") // morning | afternoon | evening | anytime
  unitLabel    String? // measured habit: "gelas", "menit", "halaman"
  unitTarget   Float? // daily target for measured habits
  unitStep     Float      @default(1)
  reminderTime String? // "07:00"
  stackAfter   String? // habit stacking trigger text
  archived     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  logs         HabitLog[]
}

model HabitLog {
  id      String  @id @default(cuid())
  habitId String
  habit   Habit   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    String // YYYY-MM-DD
  status  String  @default("done") // done | missed | rest
  value   Float?
  note    String?

  @@unique([habitId, date])
  @@index([date])
}

// ============ FITNESS (Performance Studio) ============

model Workout {
  id          String   @id @default(cuid())
  type        String // run | walk | runwalk | badminton | strength
  title       String?
  date        String // YYYY-MM-DD
  startTime   String? // "06:30"
  durationMin Float
  distanceKm  Float?
  calories    Float?
  paceMin     Float? // minutes per km
  notes       String?
  strength    String? // JSON [{exercise, muscleGroup, weight, reps, sets}]
  createdAt   DateTime @default(now())

  @@index([date])
}

model Exercise {
  id          String @id @default(cuid())
  name        String
  muscleGroup String // chest | back | shoulders | arms | legs | core | fullbody
  equipment   String?
}

model FoodItem {
  id       String @id @default(cuid())
  name     String
  calories Float
  protein  Float?
  carbs    Float?
  fat      Float?
  serving  String?
}

model FoodEntry {
  id        String   @id @default(cuid())
  name      String
  portion   String?
  calories  Float
  protein   Float?
  carbs     Float?
  fat       Float?
  meal      String   @default("lunch") // breakfast | lunch | dinner | snack
  date      String // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@index([date])
}

model CheckIn {
  id         String   @id @default(cuid())
  date       String   @unique // YYYY-MM-DD
  mood       Int? // 1..5
  energy     Int? // 1..5
  soreness   Int? // 1..5
  stress     Int? // 1..5
  sleepHours Float?
  note       String?
  createdAt  DateTime @default(now())
}

model BodyMetric {
  id               String @id @default(cuid())
  date             String @unique // YYYY-MM-DD
  weightKg         Float?
  hydrationGlasses Float?
}

// ============ FINANCE (The Vault) ============

model Wallet {
  id             String        @id @default(cuid())
  name           String
  type           String        @default("cash") // cash | bank | ewallet
  initialBalance Float         @default(0)
  color          String        @default("teal")
  icon           String        @default("wallet")
  archived       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  outTransactions Transaction[] @relation("WalletSource")
  inTransactions  Transaction[] @relation("WalletTarget")
}

model Transaction {
  id         String   @id @default(cuid())
  type       String // income | expense | transfer
  amount     Float
  category   String // makan, transport, tagihan, belanja, hiburan, kesehatan, edukasi, gaji, freelance, hadiah, lainnya
  walletId   String
  wallet     Wallet   @relation("WalletSource", fields: [walletId], references: [id], onDelete: Cascade)
  toWalletId String?
  toWallet   Wallet?  @relation("WalletTarget", fields: [toWalletId], references: [id], onDelete: SetNull)
  date       String // YYYY-MM-DD
  note       String?
  recurring  String   @default("none") // none | weekly | monthly
  createdAt  DateTime @default(now())

  @@index([date])
  @@index([walletId])
  @@index([toWalletId])
}

model Budget {
  id           String @id @default(cuid())
  category     String @unique
  monthlyLimit Float
}

model SavingsGoal {
  id            String   @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      String?
  color         String   @default("teal")
  icon          String   @default("piggy-bank")
  createdAt     DateTime @default(now())
}

// ============ JOURNAL (Writing Room) ============

model JournalEntry {
  id        String   @id @default(cuid())
  title     String   @default("")
  content   String
  folder    String   @default("Umum") // Umum | Refleksi | Ide | Sorotan
  mood      String? // great | good | neutral | tough | low
  pinned    Boolean  @default(false)
  wordCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ GAMIFICATION ============

model Achievement {
  id          String  @id @default(cuid())
  key         String  @unique
  title       String
  description String
  icon        String
  unlockedAt  String? // date string when unlocked, null = locked
}

model Quote {
  id     String @id @default(cuid())
  text   String
  author String
}
